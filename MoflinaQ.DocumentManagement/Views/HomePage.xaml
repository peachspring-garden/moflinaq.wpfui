<Page x:Class="MoflinaQ.DocumentManagement.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="ホーム">
  <Page.Resources>
    <Style x:Key="DashboardCardStyle" TargetType="{x:Type Border}">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="CardHeaderBandStyle" TargetType="{x:Type Border}">
      <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
      <Setter Property="CornerRadius" Value="8,8,0,0" />
      <Setter Property="Padding" Value="16,10" />
    </Style>
    <Style x:Key="KpiTitleStyle" TargetType="{x:Type TextBlock}">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="KpiValueStyle" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="30" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
    <Style x:Key="KpiUnitStyle" TargetType="{x:Type TextBlock}">
      <Setter Property="Margin" Value="4,0,0,3" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
    <Style x:Key="SubTextStyle" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <DataTemplate x:Key="WorkItemTemplate">
      <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,10">
        <StackPanel>
          <Border Background="{Binding ChipBackground}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{Binding ChipForeground}" />
          </Border>
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" />
          <TextBlock Text="{Binding DateText}" Style="{StaticResource SubTextStyle}" Margin="0,2,0,0" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="NoticeItemTemplate">
      <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,6,8,0" VerticalAlignment="Top"
                   Fill="#C42B1C" Visibility="{Binding UnreadVisibility}" />
          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Meta}" Style="{StaticResource SubTextStyle}" Margin="0,2,0,0" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Page.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <TextBlock x:Name="TodayText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

      <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}" Margin="0,0,6,0" Padding="16,12">
          <StackPanel>
            <Grid>
              <TextBlock Text="登録文書" Style="{StaticResource KpiTitleStyle}" />
              <ui:SymbolIcon Symbol="Document24" HorizontalAlignment="Right" FontSize="18" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <TextBlock Text="1" Style="{StaticResource KpiValueStyle}" />
              <TextBlock Text="件" Style="{StaticResource KpiUnitStyle}" />
            </StackPanel>
            <TextBlock Text="施行中 1 件・改訂中 0件" Style="{StaticResource SubTextStyle}" Margin="0,4,0,0" />
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource DashboardCardStyle}" Margin="6,0" Padding="16,12">
          <StackPanel>
            <Grid>
              <TextBlock Text="自分の担当案件" Style="{StaticResource KpiTitleStyle}" />
              <ui:SymbolIcon Symbol="Briefcase24" HorizontalAlignment="Right" FontSize="18" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <TextBlock Text="4" Style="{StaticResource KpiValueStyle}" />
              <TextBlock Text="件" Style="{StaticResource KpiUnitStyle}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}" Margin="6,0" Padding="16,12">
          <StackPanel>
            <Grid>
              <TextBlock Text="承認待ち" Style="{StaticResource KpiTitleStyle}" />
              <ui:SymbolIcon Symbol="Clock24" HorizontalAlignment="Right" FontSize="18" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <TextBlock Text="2" Style="{StaticResource KpiValueStyle}" />
              <TextBlock Text="件" Style="{StaticResource KpiUnitStyle}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Column="3" Margin="6,0,0,0" Padding="16,12" CornerRadius="8" BorderThickness="1"
                Background="#FDECEA" BorderBrush="#F1C0BC">
          <StackPanel>
            <Grid>
              <TextBlock Text="期限超過" Style="{StaticResource KpiTitleStyle}" Foreground="#B3261E" />
              <ui:SymbolIcon Symbol="Warning24" HorizontalAlignment="Right" FontSize="18" Foreground="#B3261E" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <TextBlock Text="1" Style="{StaticResource KpiValueStyle}" Foreground="#B3261E" />
              <TextBlock Text="件要対応" Style="{StaticResource KpiUnitStyle}" Foreground="#B3261E" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <Grid Margin="0,16,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}" Margin="0,0,8,0">
          <StackPanel>
            <Border Style="{StaticResource CardHeaderBandStyle}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Warning24" FontSize="16" Foreground="#B3261E" VerticalAlignment="Center" />
                <TextBlock Text="承認待ち・期限超過アラート" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <ItemsControl x:Name="AlertsList" ItemTemplate="{StaticResource WorkItemTemplate}" />
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource DashboardCardStyle}" Margin="8,0,0,0">
          <StackPanel>
            <Border Style="{StaticResource CardHeaderBandStyle}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="16" VerticalAlignment="Center" />
                <TextBlock Text="自分の担当案件・最近の院内通知" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <ItemsControl x:Name="TasksList" ItemTemplate="{StaticResource WorkItemTemplate}" />
            <TextBlock Text="院内通知（未読 3 件）" FontWeight="SemiBold" Margin="16,14,16,2" />
            <ItemsControl x:Name="NoticesList" ItemTemplate="{StaticResource NoticeItemTemplate}" />
          </StackPanel>
        </Border>
      </Grid>

      <TextBlock Text="担当案件と院内通知はサンプルです。登録文書は選択中の年度のデータを集計しています。"
                 Style="{StaticResource SubTextStyle}" Margin="0,12,0,0" />
    </StackPanel>
  </ScrollViewer>
</Page>
