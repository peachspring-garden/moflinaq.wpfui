<Page x:Class="MoflinaQ.DocumentManagement.Views.ApprovalRequestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="稟議書">
  <Page.Resources>
    <Style x:Key="CardStyle" TargetType="{x:Type Border}">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="SubTextStyle" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="TableHeaderStyle" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="FilterButtonStyle" TargetType="{x:Type Button}">
      <Setter Property="Padding" Value="14,5" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="{x:Type ListBoxItem}">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <DataTemplate x:Key="StepChipTemplate">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Background="{Binding ChipBackground}" BorderBrush="{Binding ChipBorder}" BorderThickness="1"
                CornerRadius="4" Padding="5,2">
          <TextBlock Text="{Binding Role}" FontSize="10" Foreground="{Binding ChipForeground}" />
        </Border>
        <TextBlock Text="→" FontSize="10" Margin="3,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="{Binding ArrowVisibility}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="StepCardTemplate">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="118" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="10,8">
          <StackPanel>
            <TextBlock Text="{Binding Role}" FontWeight="SemiBold" FontSize="12" />
            <TextBlock Text="{Binding Name}" FontSize="12" Margin="0,2,0,0" />
            <Border Background="{Binding ChipBackground}" BorderBrush="{Binding ChipBorder}" BorderThickness="1"
                    CornerRadius="4" Padding="5,1" HorizontalAlignment="Left" Margin="0,6,0,0">
              <TextBlock Text="{Binding StateText}" FontSize="10" Foreground="{Binding ChipForeground}" />
            </Border>
            <TextBlock Text="{Binding DecidedOn}" Style="{StaticResource SubTextStyle}" FontSize="11" Margin="0,4,0,0" />
          </StackPanel>
        </Border>
        <TextBlock Text="→" Margin="4,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="{Binding ArrowVisibility}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ApprovalRowTemplate">
      <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
              Padding="16,12" Cursor="Hand">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="470" />
            <ColumnDefinition Width="60" />
            <ColumnDefinition Width="100" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Number}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding DraftDate}" Style="{StaticResource SubTextStyle}" Margin="0,2,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding DeptDrafter}" Style="{StaticResource SubTextStyle}" Margin="0,2,0,0" />
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding AmountText}" FontWeight="SemiBold"
                     HorizontalAlignment="Right" VerticalAlignment="Center" />
          <ItemsControl Grid.Column="3" ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepChipTemplate}"
                        VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ui:SymbolIcon Symbol="Attach24" FontSize="14" />
            <TextBlock Text="{Binding AttachmentCount}" Margin="3,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <Border Grid.Column="5" Background="{Binding StatusBackground}" CornerRadius="6" Padding="8,3"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{Binding StatusForeground}" />
          </Border>
        </Grid>
      </Border>
    </DataTemplate>
  </Page.Resources>

  <Grid>
    <!-- 一覧 -->
    <ScrollViewer x:Name="ListRoot" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24">
        <Grid>
          <StackPanel>
            <TextBlock Text="総務課 / 電子決裁ワークフロー" Style="{StaticResource SubTextStyle}" />
            <TextBlock Text="稟議・決裁管理" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" />
            <TextBlock Text="起案作成、承認経路の進捗追跡、差戻し・決裁履歴および添付資料管理"
                       Style="{StaticResource SubTextStyle}" Margin="0,4,0,0" />
          </StackPanel>
          <ui:Button x:Name="NewButton" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Icon="{ui:SymbolIcon Add24}" Content="新規稟議を起案" Click="NewButton_Click" />
        </Grid>

        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0" Padding="12">
          <Grid>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="FilterAll" Style="{StaticResource FilterButtonStyle}" Content="すべて" Tag="All" Click="FilterButton_Click" />
              <Button x:Name="FilterPending" Style="{StaticResource FilterButtonStyle}" Content="承認待ち" Tag="Pending" Click="FilterButton_Click" />
              <Button x:Name="FilterReturned" Style="{StaticResource FilterButtonStyle}" Content="差戻し" Tag="Returned" Click="FilterButton_Click" />
              <Button x:Name="FilterApproved" Style="{StaticResource FilterButtonStyle}" Content="決裁済" Tag="Approved" Click="FilterButton_Click" />
            </StackPanel>
            <TextBlock Text="※行をクリックすると承認経路履歴・添付資料・決裁操作が開きます"
                       Style="{StaticResource SubTextStyle}" FontSize="11"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
          <StackPanel>
            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                    Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8,8,0,0" Padding="16,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition Width="470" />
                  <ColumnDefinition Width="60" />
                  <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="稟議番号 / 起案日" Style="{StaticResource TableHeaderStyle}" />
                <TextBlock Grid.Column="1" Text="件名・起案部署" Style="{StaticResource TableHeaderStyle}" />
                <TextBlock Grid.Column="2" Text="申請金額" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" Text="承認経路進捗" Style="{StaticResource TableHeaderStyle}" />
                <TextBlock Grid.Column="4" Text="添付" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="ステータス" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Center" />
              </Grid>
            </Border>
            <ListBox x:Name="RowsList" ItemTemplate="{StaticResource ApprovalRowTemplate}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="RowsList_SelectionChanged" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- 詳細 -->
    <ScrollViewer x:Name="DetailRoot" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
      <StackPanel Margin="24">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ui:Button Icon="{ui:SymbolIcon ArrowLeft24}" Content="戻る" Click="BackButton_Click" />
            <TextBlock x:Name="DetailNumber" FontSize="16" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
            <Border x:Name="DetailStatusChip" CornerRadius="6" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="DetailStatusText" FontSize="11" />
            </Border>
          </StackPanel>
          <StackPanel x:Name="OpsPanel" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button x:Name="ReturnButton" Content="差戻し" Margin="0,0,8,0" Click="ReturnButton_Click" />
            <ui:Button x:Name="ApproveButton" Content="承認" Appearance="Primary" Click="ApproveButton_Click" />
          </StackPanel>
          <StackPanel x:Name="EditOpsPanel" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
            <ui:Button Content="キャンセル" Margin="0,0,8,0" Click="BackButton_Click" />
            <ui:Button Content="保存" Appearance="Primary" Click="SaveButton_Click" />
          </StackPanel>
        </Grid>

        <StackPanel x:Name="DetailViewPanel">
          <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0" Padding="16">
            <StackPanel>
              <TextBlock Text="基本情報" FontWeight="SemiBold" />
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="100" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="件名" Style="{StaticResource SubTextStyle}" Margin="0,0,0,8" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DetailTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="起案日" Style="{StaticResource SubTextStyle}" Margin="0,0,0,8" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DetailDraftDate" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="起案部署 / 起案者" Style="{StaticResource SubTextStyle}" Margin="0,0,0,8" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DetailDeptDrafter" />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="申請金額" Style="{StaticResource SubTextStyle}" Margin="0,0,0,8" />
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DetailAmount" />
                <TextBlock Grid.Row="4" Grid.Column="0" Text="内容" Style="{StaticResource SubTextStyle}" />
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DetailContent" TextWrapping="Wrap" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="16">
            <StackPanel>
              <TextBlock Text="承認経路" FontWeight="SemiBold" />
              <ItemsControl x:Name="DetailStepsList" ItemTemplate="{StaticResource StepCardTemplate}" Margin="0,10,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0" Padding="16">
              <StackPanel>
                <TextBlock Text="添付ファイル" FontWeight="SemiBold" />
                <ItemsControl x:Name="DetailAttachmentsList" Margin="0,8,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <ui:SymbolIcon Symbol="Attach24" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding}" Margin="6,0,0,0" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="DetailNoAttachments" Text="添付ファイルはありません" Style="{StaticResource SubTextStyle}" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0" Padding="16">
              <StackPanel>
                <TextBlock Text="決裁履歴" FontWeight="SemiBold" />
                <ItemsControl x:Name="DetailHistoryList" Margin="0,8,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>

        <Border x:Name="DetailEditPanel" Style="{StaticResource CardStyle}" Margin="0,16,0,0" Padding="16" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Text="新規稟議の起案" FontWeight="SemiBold" />
            <TextBlock Text="件名 *" Style="{StaticResource SubTextStyle}" Margin="0,12,0,4" />
            <TextBox x:Name="EditTitle" />
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="起案部署" Style="{StaticResource SubTextStyle}" Margin="0,0,0,4" />
                <TextBox x:Name="EditDepartment" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="起案者" Style="{StaticResource SubTextStyle}" Margin="0,0,0,4" />
                <TextBox x:Name="EditDrafter" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="申請金額（円）" Style="{StaticResource SubTextStyle}" Margin="0,0,0,4" />
                <TextBox x:Name="EditAmount" />
              </StackPanel>
            </Grid>
            <TextBlock Text="内容" Style="{StaticResource SubTextStyle}" Margin="0,10,0,4" />
            <TextBox x:Name="EditContent" AcceptsReturn="True" Height="90" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
            <TextBlock x:Name="EditValidation" Foreground="#B3261E" Margin="0,8,0,0" Visibility="Collapsed" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
